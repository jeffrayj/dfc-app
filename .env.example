# Dalmia Football Club (DFC) Environment Variables
# Copy this file to .env.local

# Supabase Project URL and Public Anon Key
# (Found in Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Server-side ONLY, NEVER expose in browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Club Accent Color Configuration (Optional, default is Emerald #059669)
NEXT_PUBLIC_CLUB_PRIMARY_COLOR=#059669
NEXT_PUBLIC_CLUB_ACCENT_COLOR=#f59e0b
